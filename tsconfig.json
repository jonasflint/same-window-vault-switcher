{
	"compilerOptions": {
		"baseUrl": ".",
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitThis": false,
		"importHelpers": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"lib": ["DOM", "ES2020"]
	},
	"include": ["main.ts"]
}
